# /home/ecstel/work/.env 의 형식 견본.
#
# 실제 .env 는 .gitignore 로 커밋이 막혀 있다(비밀값). 이 파일은 **키 목록과 형식만** 남겨,
# 서버를 다시 세울 때 "무슨 값이 필요한지"를 알 수 있게 한다. 값은 채우지 않는다.
#
# 이 파일을 읽는 곳:
#   - glassvue-backend.service 의 ExecStart 가 직접 소싱한다 (EnvironmentFile 을 못 쓴다 — 유닛 주석 참고)
#   - `./gradlew test` 를 돌리기 전에도 반드시 소싱해야 한다. 안 하면 DB 통합 테스트가
#     **조용히 skip 되고 BUILD SUCCESSFUL 로 끝난다** (WORKING-AGREEMENTS §3)
#       set -a; . /home/ecstel/work/.env; set +a

# --- Oracle ---
# 이 서버 자신에서 도는 19c. DB_PORT 가 1521 이 아니라 3306 인 것은 오타가 아니다(리스너 설정).
# DB_HOST 는 서버 IP다. IP 가 바뀌면 여기도 바꿔야 한다 — 2026-07-22 에 .36 → .14 로 바뀌며
# 운영이 통째로 내려간 적이 있다(2026-07-22 핸드오프 §2). 이후 IP 는 정적으로 고정했다.
DB_HOST=192.168.50.14
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_SERVICE=espdb

# 마이그레이션 빈-DB 검증 전용 계정(esptest)의 비밀번호.
# 검증 절차는 glassvue-backend/src/main/resources/db/migration/README.md 참고.
# ⚠ 문서에 평문으로 적지 않는다 — 저장소에 남으면 히스토리에서 못 지운다(2026-07-29).
ESPTEST_PASSWORD=

# --- JWT ---
# 서명 키. 바꾸면 **발급된 토큰이 전부 무효**가 되어 전 사용자가 로그아웃된다.
# 최소 256bit 이상의 랜덤값:  openssl rand -base64 48
JWT_SECRET=
