# Lombok 이 만든 메서드(getter/builder/equals/hashCode/toString)에 @lombok.Generated 를 붙인다.
# JaCoCo 는 그 애노테이션이 붙은 메서드를 커버리지 계산에서 **제외**한다 (H-5, 2026-07-31).
#
# ⚠ 이 한 줄이 없으면 커버리지가 **우리가 쓴 코드가 아니라 생성 코드에 좌우된다** —
#    엔티티마다 붙는 빌더·게터가 줄 수로는 로직보다 많고, 테스트가 우연히 스치기만 해도 숫자가 오른다.
#    H-5 의 목적은 "어느 분기를 안 봤나" 를 찾는 것이라, 볼 필요 없는 코드는 애초에 세지 않는다.
lombok.addLombokGeneratedAnnotation = true

# 상위 디렉토리의 lombok.config 를 더 찾지 않는다(이 파일이 프로젝트 루트 설정).
config.stopBubbling = true
